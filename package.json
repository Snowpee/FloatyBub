    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.2",
    "@fishaudio/agent-react": "^0.3.0",
    "@react-spring/web": "^10.1.2",
    "@sparticuz/chromium-min": "^143.0.4",
    "@supabase/supabase-js": "^2.119.0",
    "@use-gesture/react": "^10.3.1",
    "@vercel/analytics": "^1.6.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
