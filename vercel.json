{
  "functions": {
    "api/tts.js": {
      "maxDuration": 30
    },
    "api/health.js": {
      "maxDuration": 10
    },
    "api/models.js": {
      "maxDuration": 10
    },
    "api/model-info.js": {
      "maxDuration": 15
    },
    "api/search.js": {
      "maxDuration": 10
    },
    "api/voice-session.js": {
      "maxDuration": 20
    },
    "api/llm-gateway.js": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/v1/chat/completions",
      "destination": "/api/llm-gateway"
    },
    {
      "source": "/api/model-info/([^/]+)",
      "destination": "/api/model-info?modelId=$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
